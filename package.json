{
  "name": "portal-room",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "62 salas de gravedad, agua, slime, arena, telas y saltadores de goma",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "serve": "python3 -m http.server 8080",
    "test:browser": "python3 tests/browser.py",
    "test:course": "node scripts/verify-course.mjs",
    "test:ui": "python3 tests/browser.py --ui-only",
    "test:experience": "python3 tests/experience-browser.py --offline",
    "test:render": "python3 tests/shaders_egl.py",
    "test:static": "python3 scripts/verify-static.py",
    "test:quality": "python3 tests/quality-browser.py",
    "test:materials": "python3 tests/materials_egl.py",
    "test:relief": "node tests/relief-webgl.mjs",
    "test:stability": "node tests/render-stability-browser.mjs",
    "test:webgl": "python3 tests/shaders_egl.py --webgl",
    "test:materials:webgl": "python3 tests/materials_egl.py --webgl",
    "benchmark:render": "node tests/render-benchmark.mjs",
    "test:regressions": "python3 tests/review-regressions-browser.py",
    "test:hand-render": "node tests/hand-atelier-browser.mjs",
    "test:transitions": "node tests/level-transition-browser.mjs",
    "test:hands": "node tests/hand-mediapipe-browser.mjs",
    "test:audio": "python3 tests/audio-browser.py",
    "test:hand-menu": "python3 tests/hand-menu-browser.py",
    "test:living-materials": "node tests/living-materials-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:motion-visual": "node tests/motion-visual.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
